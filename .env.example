# ── Frontend (Vite) ─────────────────────────────────────────
# Leave these empty to run in DEMO MODE with sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where the payment server (server/index.js) runs
VITE_API_URL=http://localhost:5050

# ── Payment server (server/index.js) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SSLCZ_STORE_ID=testbox
SSLCZ_STORE_PASSWORD=qwerty
SSLCZ_SANDBOX=true
FRONTEND_URL=http://localhost:5173
PORT=5050

# ── Omni-Eye AI camera reports (server/ai.js) ───────────────
# Shared secret the Omni-Eye node sends in the x-omnieye-key header.
# Required on the deployed backend (Render); locally it defaults to omnieye-dev-key.
OMNIEYE_INGEST_KEY=omnieye-dev-key
# With SUPABASE_SERVICE_ROLE_KEY set (above), AI reports are stored in the Supabase Storage
# bucket "omnieye-reports" instead of server/ai_data/. Force either with AI_STORE=supabase|file

# ── SMS (BulkSMSBD) ─────────────────────────────────────────
# Used for driver notifications and for the per-video summary SMS to the officers of a camera's
# area (server/alerts.js). BulkSMSBD only accepts whitelisted IPs, so this works from Render,
# usually not from a home PC. Leave empty to skip SMS.
SMS_API_KEY=
SMS_SENDER_ID=
# Public website address, used in SMS links (never localhost)
PUBLIC_SITE_URL=https://smart-mamla.vercel.app

# ── Telegram evidence posts (server/telegram.js) ────────────
# One group for all camera locations: the video summary + an album of the evidence photos.
# Token from @BotFather; chat id from GET /api/ai/telegram/chats after adding the bot to the group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
